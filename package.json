{
  "name": "hudson-transit",
  "version": "0.1.0",
  "private": true,
  "description": "Live PATH + NYC Subway arrivals board for Hoboken/NYC commuters",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stations": "tsx scripts/build-stations.ts",
    "fixtures": "tsx scripts/record-fixtures.ts",
    "probe": "tsx scripts/probe-feeds.ts"
  },
  "dependencies": {
    "gtfs-realtime-bindings": "2.2.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.6",
    "fflate": "^0.8.3",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.2"
  }
}
